rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('role', 'admin') in ['admin', 'superAdmin'];
    }

    match /wallpapers/{fileName} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.contentType.matches('image/jpeg')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Photos attached to "Today at the Temple" rows and to Latest Updates.
    match /today/{fileName} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.contentType.matches('image/jpeg')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /updates/{fileName} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.contentType.matches('image/jpeg')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
