{
  "expo": {
    "name": "Ayyappa Seva",
    "slug": "ayyappa-seva",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0B0B08"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Ayyappa Seva to access your photos for devotional wallpapers.",
          "savePhotosPermission": "Allow Ayyappa Seva to save devotional wallpapers to your photos.",
          "granularPermissions": []
        }
      ],
      "react-native-pdf-jsi",
      [
        "expo-notifications",
        {
          "color": "#E9B949",
          "defaultChannel": "event-reminders"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.varktraditions.ayyappaseva.mobile",
      "version": "1.0.2",
      "buildNumber": "7"
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B08"
      },
      "package": "com.varktraditions.ayyappaseva",
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "89f6a298-05f8-423b-a4e9-aaa2471fed08"
      }
    },
    "owner": "varktraditions"
  }
}
