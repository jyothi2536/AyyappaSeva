rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superAdmin'];
    }

    function isSuperAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superAdmin';
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /today/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /devotees/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'firstName', 'lastName', 'address', 'phone', 'createdAt']);
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    match /admins/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow delete: if isSuperAdmin()
        && request.auth.uid != userId
        && resource.data.role == 'admin';
      allow create, update: if false;
    }
  }
}
